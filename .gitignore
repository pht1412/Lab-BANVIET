# ==========================================
# 1. BỎ QUA MÃ NGUỒN LÕI WORDPRESS & CẤU HÌNH
# ==========================================
/wp-admin/
/wp-includes/
/wp-*.php
/xmlrpc.php
/index.php
/license.txt
/readme.html
wp-config.php

# ==========================================
# 2. BỎ QUA TÀI NGUYÊN ĐỘNG & CACHE
# ==========================================
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/
/wp-content/wflogs/
*.log

# ==========================================
# 3. BỎ QUA TOÀN BỘ THEME & PLUGIN MẶC ĐỊNH
# ==========================================
/wp-content/themes/*
/wp-content/plugins/*

# ==========================================
# 4. CHỈ THEO DÕI CÁC TÀI NGUYÊN CUSTOM CỦA BẢN VIỆT
# ==========================================
!/wp-content/plugins/banviet-lead-engine/

# ==========================================
# 5. BỘ KIỂM THỬ TỰ ĐỘNG & NODE RUNTIME (QC SUITE)
# ==========================================
# Chặn toàn bộ dependencies nặng hàng trăm MB
node_modules/
**/node_modules/
.npm/

# Bỏ qua log debug và cache của Jest
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.jest-cache/

# ==========================================
# 6. FILE RÁC CỦA HỆ ĐIỀU HÀNH & IDE
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/